# ---- Server ----
PORT=3000
HOST=127.0.0.1

# ---- Angel One SmartAPI (leave blank to run with SIMULATED data) ----
# Create a "Market Feeds" app at https://smartapi.angelone.in to get the API key.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
# Your Angel One login PIN (MPIN)
ANGEL_PIN=
# The TOTP secret shown when you enable TOTP at smartapi.angelone.in/enable-totp
ANGEL_TOTP_SECRET=

# Simulated mode only: keep fake prices moving outside market hours (for testing)
# MOCK_ALWAYS_LIVE=true
